---
interface Props {
  id?: string
  title: string
  description?: string
}

const { id, title, description } = Astro.props
---

<section id={id} class="mb-14">
  <h2 class="mb-2 text-2xl font-semibold">{title}</h2>
  {
    description && (
      <p class="text-base-content/70 mb-4 max-w-2xl">{description}</p>
    )
  }
  <slot />
</section>
