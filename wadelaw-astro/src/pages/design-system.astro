---
import BaseLayout from "@layouts/BaseLayout.astro"
import Spacer from "@components/Spacer.astro"
import SpacingScaleSection from "@components/design-system/SpacingScaleSection.astro"
import SpacingLawsSection from "@components/design-system/SpacingLawsSection.astro"
import ProximityInPracticeSection from "@components/design-system/ProximityInPracticeSection.astro"
import LoadingButtonSection from "@components/design-system/LoadingButtonSection.astro"

const swatches = [
  { name: "primary", bg: "bg-primary", fg: "text-primary-content" },
  { name: "secondary", bg: "bg-secondary", fg: "text-secondary-content" },
  { name: "accent", bg: "bg-accent", fg: "text-accent-content" },
  { name: "neutral", bg: "bg-neutral", fg: "text-neutral-content" },
  { name: "info", bg: "bg-info", fg: "text-info-content" },
  { name: "success", bg: "bg-success", fg: "text-success-content" },
  { name: "warning", bg: "bg-warning", fg: "text-warning-content" },
  { name: "error", bg: "bg-error", fg: "text-error-content" },
]

// Base surfaces — the most-used colors in the actual app.
const baseRamp = [
  { name: "base-100", bg: "bg-base-100", fg: "text-base-content" },
  { name: "base-200", bg: "bg-base-200", fg: "text-base-content" },
  { name: "base-300", bg: "bg-base-300", fg: "text-base-content" },
]

// Table of contents — each id maps to a section anchor below.
const tableOfContents = [
  { id: "themes", label: "Themes" },
  { id: "color-tokens", label: "Color tokens" },
  { id: "typography", label: "Typography" },
  { id: "spacing", label: "Spacing" },
  { id: "buttons", label: "Buttons" },
  { id: "loading-buttons", label: "Loading buttons" },
  { id: "badges", label: "Badges & alerts" },
  { id: "cards", label: "Cards" },
  { id: "forms", label: "Form controls" },
]
---

<BaseLayout title="Design System — Wade Law">
  <div class="mx-auto max-w-6xl px-4 py-12 lg:px-8">
    <header class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight">Design System</h1>
      <p class="text-base-content/70 mt-3 text-lg">
        Living reference for the tokens and components used across the Wade Law
        site. Powered by Tailwind CSS v4 and daisyUI.
      </p>
    </header>

    <div class="lk-space-2xl flex flex-col lg:flex-row lg:items-start">
      <!-- Sticky table of contents -->
      <aside class="shrink-0 lg:sticky lg:top-8 lg:w-56">
        <nav aria-label="On this page">
          <ul
            id="ds-toc"
            class="menu rounded-box w-full bg-transparent lg:w-56"
          >
            <li class="menu-title">Table of Contents</li>
            {
              tableOfContents.map((item) => (
                <li>
                  <a href={`#${item.id}`} data-toc-link={item.id}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <div class="lk-space-xl flex min-w-0 flex-1 flex-col">
        <Spacer />
        <!-- Theme switcher -->
        <section id="themes" class="mb-14 scroll-mt-8">
          <h2 class="mb-4 text-2xl font-semibold">Themes</h2>
          <p class="text-base-content/70 mb-4">
            Switch the active daisyUI theme to preview components in context.
          </p>
          <div class="join">
            {
              ["corporate", "light", "dark"].map((theme) => (
                <button
                  class="btn join-item btn-sm"
                  data-set-theme={theme}
                  type="button"
                >
                  {theme}
                </button>
              ))
            }
          </div>
        </section>

        <!-- Color tokens -->
        <section id="color-tokens" class="mb-14 scroll-mt-8">
          <h2 class="mb-4 text-2xl font-semibold">Color tokens</h2>

          <!-- Semantic chips: each shows its paired *-content color as "Aa". -->
          <div class="lk-space-sm flex flex-wrap">
            {
              swatches.map((swatch) => (
                <div class="flex flex-col items-center gap-1">
                  <div
                    class={`${swatch.bg} ${swatch.fg} rounded-box grid size-12 place-items-center text-sm font-semibold shadow-sm`}
                    title={swatch.name}
                  >
                    Aa
                  </div>
                  <span class="text-xs opacity-70">{swatch.name}</span>
                </div>
              ))
            }
          </div>

          <!-- Base surfaces — the dominant colors in real usage. -->
          <div class="lk-space-sm mt-6 flex flex-wrap">
            {
              baseRamp.map((swatch) => (
                <div class="flex flex-col items-center gap-1">
                  <div
                    class={`${swatch.bg} ${swatch.fg} rounded-box border-base-300 grid size-12 place-items-center border text-sm font-semibold`}
                    title={swatch.name}
                  >
                    Aa
                  </div>
                  <span class="text-xs opacity-70">{swatch.name}</span>
                </div>
              ))
            }
          </div>

          <!-- In context: representative ratio — mostly base, sprinkled accents. -->
          <div class="rounded-box border-base-300 bg-base-100 mt-6 border p-4">
            <div class="lk-space-sm flex flex-wrap items-center">
              <span class="text-base-content text-sm">
                Mostly <span class="font-medium">base</span> surface &amp; text,
              </span>
              <button class="btn btn-primary btn-sm" type="button">
                Primary
              </button>
              <span class="badge badge-secondary">Secondary</span>
              <span class="badge badge-accent badge-outline">Accent</span>
              <span class="text-base-content/60 text-sm">
                with small hits of color.
              </span>
            </div>
          </div>
        </section>

        <!-- Typography -->
        <section id="typography" class="mb-14 scroll-mt-8">
          <h2 class="mb-4 text-2xl font-semibold">Typography</h2>
          <div class="space-y-2">
            <h1 class="text-5xl font-bold">Heading 1</h1>
            <h2 class="text-4xl font-bold">Heading 2</h2>
            <h3 class="text-3xl font-semibold">Heading 3</h3>
            <h4 class="text-2xl font-semibold">Heading 4</h4>
            <p class="text-base-content/70 max-w-2xl">
              Body text. The quick brown fox jumps over the lazy dog. Justice is
              the constant and perpetual will to render to every man his due.
            </p>
            <p class="text-sm opacity-60">Small / muted caption text.</p>
          </div>
        </section>

        <!-- Spacing -->
        <div id="spacing" class="scroll-mt-8">
          <SpacingScaleSection />
          <SpacingLawsSection />
          <ProximityInPracticeSection />
        </div>

        <!-- Buttons -->
        <section id="buttons" class="mb-14 scroll-mt-8">
          <h2 class="mb-4 text-2xl font-semibold">Buttons</h2>
          <div class="flex flex-wrap gap-3">
            <button class="btn btn-primary">Test</button>
            <button class="btn btn-secondary">Secondary</button>
            <button class="btn btn-accent">Accent</button>
            <button class="btn btn-outline">Outline</button>
            <button class="btn btn-ghost">Ghost</button>
            <button class="btn btn-link">Link</button>
            <button class="btn btn-primary btn-sm">Small</button>
            <button class="btn btn-primary" disabled>Disabled</button>
          </div>
        </section>

        <!-- Loading buttons -->
        <div id="loading-buttons" class="scroll-mt-8">
          <LoadingButtonSection />
        </div>

        <!-- Badges & alerts -->
        <section id="badges" class="mb-14 scroll-mt-8">
          <h2 class="mb-4 text-2xl font-semibold">Badges &amp; alerts</h2>
          <div class="mb-4 flex flex-wrap gap-2">
            <span class="badge badge-primary">Primary</span>
            <span class="badge badge-secondary">Secondary</span>
            <span class="badge badge-accent">Accent</span>
            <span class="badge badge-outline">Outline</span>
            <span class="badge badge-ghost">Ghost</span>
          </div>
          <div class="space-y-3">
            <div class="alert alert-info">
              <span>Informational message for the user.</span>
            </div>
            <div class="alert alert-success">
              <span>Your request was submitted successfully.</span>
            </div>
            <div class="alert alert-warning">
              <span>Please review before continuing.</span>
            </div>
            <div class="alert alert-error">
              <span>Something went wrong.</span>
            </div>
          </div>
        </section>

        <!-- Cards -->
        <section id="cards" class="mb-14 scroll-mt-8">
          <h2 class="mb-4 text-2xl font-semibold">Cards</h2>
          <div class="grid gap-6 sm:grid-cols-2">
            <div class="card bg-base-100 border-base-200 border shadow-sm">
              <div class="card-body">
                <h3 class="card-title">Consultation</h3>
                <p class="text-base-content/70">
                  A card component used for practice areas and feature callouts.
                </p>
                <div class="card-actions justify-end">
                  <button class="btn btn-primary btn-sm">Book now</button>
                </div>
              </div>
            </div>
            <div class="card bg-primary text-primary-content shadow-sm">
              <div class="card-body">
                <h3 class="card-title">Featured</h3>
                <p>An inverted card using the primary color for emphasis.</p>
                <div class="card-actions justify-end">
                  <button class="btn btn-sm">Details</button>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Form controls -->
        <section id="forms" class="mb-14 scroll-mt-8">
          <h2 class="mb-4 text-2xl font-semibold">Form controls</h2>
          <div class="grid max-w-xl gap-4">
            <label class="form-control w-full">
              <span class="label-text mb-1">Full name</span>
              <input
                type="text"
                placeholder="Jane Doe"
                class="input input-bordered w-full"
              />
            </label>
            <label class="form-control w-full">
              <span class="label-text mb-1">Message</span>
              <textarea
                class="textarea textarea-bordered w-full"
                placeholder="How can we help?"></textarea>
            </label>
            <div class="flex items-center gap-4">
              <label class="label cursor-pointer gap-2">
                <input
                  type="checkbox"
                  class="checkbox checkbox-primary"
                  checked
                />
                <span class="label-text">Subscribe</span>
              </label>
              <input
                type="range"
                min="0"
                max="100"
                value="40"
                class="range range-primary"
              />
              <input type="checkbox" class="toggle toggle-primary" checked />
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>

  <script is:inline>
    document.querySelectorAll("[data-set-theme]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const theme = btn.getAttribute("data-set-theme")
        document.documentElement.setAttribute("data-theme", theme)
      })
    })

    // Scrollspy: highlight the TOC link for the section in view.
    const tocLinks = Array.from(document.querySelectorAll("[data-toc-link]"))
    const sections = tocLinks
      .map((link) =>
        document.getElementById(link.getAttribute("data-toc-link")),
      )
      .filter(Boolean)

    const setActive = (id) => {
      tocLinks.forEach((link) =>
        link.classList.toggle(
          "menu-active",
          link.getAttribute("data-toc-link") === id,
        ),
      )
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
        if (visible.length > 0) setActive(visible[0].target.id)
      },
      { rootMargin: "0px 0px -70% 0px", threshold: 0 },
    )

    sections.forEach((section) => observer.observe(section))
  </script>
</BaseLayout>
