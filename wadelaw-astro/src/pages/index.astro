---
import BaseLayout from "@layouts/BaseLayout.astro"
---

<BaseLayout title="Wade Law — Trusted Legal Counsel">
  <section class="hero bg-base-200 min-h-[70vh]">
    <div class="hero-content text-center">
      <div class="max-w-2xl">
        <span class="badge badge-primary badge-outline mb-4">
          Established 1998
        </span>
        <h1 class="text-4xl font-bold tracking-tight sm:text-6xl">
          Trusted legal counsel when it matters most
        </h1>
        <p class="text-base-content/70 mt-6 text-lg">
          Wade Law provides personalized representation for individuals and
          businesses across litigation, corporate, and family law.
        </p>
        <div class="mt-8 flex justify-center gap-3">
          <a href="/#contact" class="btn btn-primary">Schedule a consultation</a
          >
          <a href="/design-system" class="btn btn-ghost">View design system</a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 lg:px-8">
    <h2 class="mb-8 text-center text-3xl font-bold">Practice areas</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        [
          {
            title: "Litigation",
            body: "Aggressive, strategic representation in and out of the courtroom.",
          },
          {
            title: "Corporate Law",
            body: "Formation, contracts, and counsel for businesses of every size.",
          },
          {
            title: "Family Law",
            body: "Compassionate guidance through life's most personal matters.",
          },
        ].map((area) => (
          <div class="card bg-base-100 border-base-200 border shadow-sm">
            <div class="card-body">
              <h3 class="card-title">{area.title}</h3>
              <p class="text-base-content/70">{area.body}</p>
              <div class="card-actions mt-2">
                <a href="/#contact" class="link link-primary">
                  Learn more →
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="contact" class="bg-base-200">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center lg:px-8">
      <h2 class="text-3xl font-bold">Ready to talk?</h2>
      <p class="text-base-content/70 mt-4">
        Reach out for a confidential consultation. We respond within one
        business day.
      </p>
      <a href="mailto:hello@wadelaw.example" class="btn btn-primary mt-6">
        Contact us
      </a>
    </div>
  </section>
</BaseLayout>
